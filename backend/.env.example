ENVIRONMENT=development
DATABASE_URL=sqlite:///./creatoriq.db
MONGO_URL=mongodb://creatoriq:creatoriq@localhost:27017
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Configuration
# Get credentials from: https://console.cloud.google.com/
# Enable Google+ API and create OAuth 2.0 credentials (Web application)
# Authorized redirect URIs: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Legacy fallback variables (optional, for backward compatibility)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/youtube
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=GoogleDevelopers

# Meta (Instagram/Facebook) OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8000/api/v1/social/callback/instagram

# TikTok OAuth
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/tiktok

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/facebook

# Live Multi-Platform REST & Graph API Credentials
# GitHub (Optional Personal Access Token to eliminate 60 req/hr IP rate limits)
GITHUB_TOKEN=

# Instagram Graph API (Set access token and connected Instagram Business/Creator Account ID)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCOUNT_ID=

# LinkedIn API v2 (OAuth 2.0 Bearer access token)
LINKEDIN_ACCESS_TOKEN=

# RapidAPI Key (Optional for Instagram Data API fallback)
RAPIDAPI_KEY=